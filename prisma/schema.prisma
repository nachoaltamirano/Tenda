// LOBBY — esquema de datos.
// Convenciones:
// - Importes monetarios en CENTAVOS (Int). 45.000 ARS = 4500000.
// - Un importe null significa "dato desconocido" (no es lo mismo que 0).
// - Los registros históricos (costos, auditoría) son de solo inserción.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa para migraciones (en Supabase, la conexión de la app pasa por el pooler).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Acceso al panel
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // "Product", "PricingSettings", ...
  entityId   String
  action     String // "create", "update", "price_approved", "image_added", ...
  changes    Json? // { campo: { from, to } }
  reason     String?
  userEmail  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// ---------------------------------------------------------------------------
// Proveedor e importación asistida
// ---------------------------------------------------------------------------

enum DataSource {
  WHATSAPP_GROUP // ofertas publicadas en el grupo del proveedor
  WHATSAPP_DIRECT // consulta directa por WhatsApp
  PHONE_CALL
  SUPPLIER_LIST // lista de precios enviada como archivo
  MANUAL
  OTHER
}

model Supplier {
  id          String            @id @default(cuid())
  name        String
  city        String?
  contactNote String? // sin datos personales innecesarios
  notes       String?
  isTestData  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  products    Product[]
  messages    SupplierMessage[]
}

enum SupplierMessageStatus {
  PENDING_REVIEW
  PARTIALLY_APPLIED
  APPLIED
  DISCARDED
}

// Texto pegado tal cual fue recibido. Nunca se modifica el original.
model SupplierMessage {
  id           String                @id @default(cuid())
  supplierId   String
  supplier     Supplier              @relation(fields: [supplierId], references: [id])
  source       DataSource
  rawText      String
  receivedAt   DateTime? // fecha/hora en que el proveedor lo envió, si se conoce
  consultedAt  DateTime // fecha de la consulta / lectura del mensaje
  status       SupplierMessageStatus @default(PENDING_REVIEW)
  parsedResult Json? // propuesta del intérprete (para auditoría)
  createdBy    String?
  isTestData   Boolean               @default(false)
  createdAt    DateTime              @default(now())

  attachments    SupplierMessageAttachment[]
  costEntries    ProductCostHistory[]
  priceProposals PriceChangeProposal[]
  orderItems     OrderItem[]

  @@index([consultedAt])
}

// Foto subida junto con un mensaje del proveedor. Se asigna a un producto
// por nombre de archivo al revisar el mensaje. Los archivos no se duplican:
// la imagen del producto apunta a las mismas claves.
model SupplierMessageAttachment {
  id           String          @id @default(cuid())
  messageId    String
  message      SupplierMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename     String
  filenameKey  String // minúsculas, para buscar por nombre
  originalKey  String
  optimizedKey String
  thumbKey     String
  mimeType     String
  width        Int?
  height       Int?
  sizeBytes    Int
  contentHash  String // SHA-256 del archivo original
  createdAt    DateTime        @default(now())
  images       ProductImage[]

  @@unique([messageId, filenameKey])
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

enum AvailabilityStatus {
  PENDING_VERIFICATION // Pendiente de verificar
  AVAILABLE_LAST_CHECK // Disponible según última consulta
  CONFIRMED_FOR_ORDER // Disponibilidad confirmada para un pedido
  SOLD_OUT_CONFIRMED // Agotado confirmado
  DISCONTINUED // Discontinuado
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum Currency {
  ARS
  USD
}

model Product {
  id          String    @id @default(cuid())
  internalSku String    @unique
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  supplierSku String?
  brand       String
  model       String
  nameKey     String // marca+modelo normalizados, para detectar duplicados
  slug        String    @unique
  description String?
  category    String?
  currency    Currency  @default(ARS)

  // Costos vigentes (centavos). null = desconocido.
  costPrice       Int?
  transportCost   Int?
  otherCosts      Int?
  accessoriesCost Int?
  costUpdatedAt   DateTime? // fecha de la consulta que dio origen al costo vigente

  // Precio publicado (centavos). Solo cambia por acción explícita del administrador.
  salePrice          Int?
  salePriceUpdatedAt DateTime?

  // Oferta informada por el proveedor. La disponibilidad puntual de cada par
  // se confirma con el proveedor cuando un cliente consulta.
  sizesOffered   String[] @default([]) // "38".."43", "40.5"
  colorsOffered  String[] @default([]) // vacío = no informado / surtido
  assortmentNote String? // "Surtidas (sueltas a elección)"

  availabilityStatus    AvailabilityStatus @default(PENDING_VERIFICATION)
  publicationStatus     PublicationStatus  @default(DRAFT)
  estimatedDeliveryDays Int? // null = usar el plazo general configurado

  dataSource      DataSource @default(MANUAL)
  dataDate        DateTime? // fecha del dato informado por la fuente
  dataVerified    Boolean    @default(false)
  lastConsultedAt DateTime?

  // Próximo despacho informado por el proveedor
  nextDispatchDate      DateTime?
  nextDispatchWeekday   Int? // 0=domingo..6=sábado, cuando solo se informó el día
  nextDispatchMode      String?
  nextDispatchConfirmed Boolean   @default(false)

  notes      String?
  conditions String?
  isTestData Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  images         ProductImage[]
  costHistory    ProductCostHistory[]
  priceProposals PriceChangeProposal[]
  orderItems     OrderItem[]

  @@index([nameKey])
  @@index([supplierId, supplierSku])
  @@index([publicationStatus])
}

enum ImageSourceType {
  SUPPLIER
  OWN_PHOTO
  OTHER_AUTHORIZED
}

// Las imágenes no se borran físicamente: se marcan con deletedAt para no
// romper pedidos ni publicaciones que las referencian.
model ProductImage {
  id                       String                     @id @default(cuid())
  productId                String
  product                  Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  originalKey              String
  optimizedKey             String?
  thumbKey                 String?
  mimeType                 String
  width                    Int?
  height                   Int?
  sourceType               ImageSourceType
  sourceNote               String?
  authorizedForPublication Boolean                    @default(false)
  position                 Int                        @default(0)
  isCover                  Boolean                    @default(false)
  attachmentId             String?
  contentHash              String? // SHA-256 del original, para no repetir la misma foto
  attachment               SupplierMessageAttachment? @relation(fields: [attachmentId], references: [id])
  deletedAt                DateTime?
  createdAt                DateTime                   @default(now())

  @@index([productId, position])
}

// Historial de costos: una fila por cada costo confirmado. Solo inserción.
model ProductCostHistory {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency          Currency
  costPrice         Int?
  transportCost     Int?
  otherCosts        Int?
  consultedAt       DateTime
  source            DataSource
  supplierMessageId String?
  supplierMessage   SupplierMessage? @relation(fields: [supplierMessageId], references: [id])
  note              String?
  createdBy         String?
  createdAt         DateTime         @default(now())

  @@index([productId, consultedAt])
}

enum PriceProposalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

// Propuesta de cambio de costo/precio pendiente de aprobación.
model PriceChangeProposal {
  id                String              @id @default(cuid())
  productId         String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierMessageId String?
  supplierMessage   SupplierMessage?    @relation(fields: [supplierMessageId], references: [id])
  source            DataSource
  oldCostPrice      Int?
  newCostPrice      Int
  oldConsultedAt    DateTime?
  newConsultedAt    DateTime
  oldSalePrice      Int?
  proposedSalePrice Int? // precio sugerido con el nuevo costo
  impact            Json // snapshot del cálculo antes/después
  belowMinMargin    Boolean             @default(false)
  status            PriceProposalStatus @default(PENDING)
  appliedSalePrice  Int?
  decidedBy         String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime            @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Configuración (filas únicas id = 1)
// ---------------------------------------------------------------------------

enum TargetMode {
  FIXED_PROFIT // ganancia fija en centavos
  MARGIN_PERCENT // margen sobre precio de venta
  MARKUP_PERCENT // recargo sobre costo total
}

enum RoundingMode {
  UP
  NEAREST
  DOWN
}

model PricingSettings {
  id                   Int          @id @default(1)
  configured           Boolean      @default(false) // false hasta que el administrador revise los valores
  packagingCost        Int? // embalaje por par
  deliveryCostAssumed  Int? // envío al cliente que asume LOBBY
  defaultTransportCost Int? // transporte desde el proveedor, si el producto no tiene uno propio
  paymentFeePercent    Float? // comisión de cobro sobre el precio de venta
  paymentFeeFixed      Int?
  taxPercent           Float? // impuestos sobre el precio de venta (ej. IIBB)
  targetMode           TargetMode   @default(MARGIN_PERCENT)
  targetValue          Float? // centavos si FIXED_PROFIT; porcentaje si no
  minMarginPercent     Float?
  roundingStep         Int          @default(100000) // 1.000 ARS
  roundingMode         RoundingMode @default(UP)
  roundingOffset       Int          @default(0) // ej. -10000 para terminar en 900
  stalePriceDays       Int          @default(7) // días tras los cuales un costo se considera desactualizado
  updatedAt            DateTime     @updatedAt
}

model DispatchSettings {
  id               Int      @id @default(1)
  weekdays         Int[]    @default([2, 4, 5]) // martes, jueves, viernes
  maxEstimatedDays Int      @default(5)
  updatedAt        DateTime @updatedAt
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  description String
}

// ---------------------------------------------------------------------------
// Clientes y pedidos (etapa 3)
// ---------------------------------------------------------------------------

enum SalesChannel {
  WEBSITE
  INSTAGRAM
  FACEBOOK_MARKETPLACE
  WHATSAPP
  OTHER
}

// Solo los datos necesarios para contactar y entregar.
model Customer {
  id         String       @id @default(cuid())
  name       String
  phone      String?
  phoneKey   String? // solo dígitos, para buscar y evitar duplicados
  channel    SalesChannel @default(WHATSAPP)
  notes      String?
  isTestData Boolean      @default(false)
  createdAt  DateTime     @default(now())
  orders     Order[]

  @@index([phoneKey])
}

enum OrderStatus {
  INQUIRY // 1. Consulta recibida
  VERIFYING_PRODUCT // 2. Verificando producto
  AWAITING_SUPPLIER // 3. Esperando confirmación del proveedor
  QUOTE_SENT // 4. Cotización enviada
  AWAITING_CUSTOMER // 5. Esperando confirmación del cliente
  CONFIRMED // 6. Pedido confirmado
  PURCHASE_PENDING // 7. Compra pendiente
  PURCHASED // 8. Comprado al proveedor
  IN_TRANSIT // 9. En tránsito
  RECEIVED_PENDING_INSPECTION // 10. Recibido: pendiente de inspección
  INSPECTED_APPROVED // 11. Inspeccionado y aprobado
  AWAITING_PAYMENT // 12. Esperando pago
  PAYMENT_CONFIRMED // 13. Pago confirmado
  READY_FOR_DELIVERY // 14. Preparado para entrega
  DELIVERED // 15. Enviado o entregado
  CLOSED // 16. Cerrado
  CANCELLED
  RETURNED
  INCIDENT
}

enum DeliveryMethod {
  PICKUP // retiro en persona
  OWN_DELIVERY // entrega propia
  CARRIER // envío por transporte o correo
}

model Order {
  id                   String       @id @default(cuid())
  code                 String       @unique // LB-2610-0001
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id])
  channel              SalesChannel
  status               OrderStatus  @default(INQUIRY)
  statusBeforeIncident OrderStatus?

  // Proveedor y despacho. Las fechas estimadas y las confirmadas se guardan por separado.
  supplierQueriedAt     DateTime?
  supplierConfirmedAt   DateTime? // el proveedor confirmó disponibilidad del par puntual
  supplierConfirmNote   String?
  estimatedDispatchDate DateTime? @db.Date
  confirmedDispatchDate DateTime? @db.Date
  actualDispatchDate    DateTime? @db.Date
  estimatedArrivalDate  DateTime? @db.Date
  actualArrivalDate     DateTime? @db.Date
  carrier               String?
  trackingCode          String?
  purchasedAt           DateTime?

  // Entrega
  deliveryMethod      DeliveryMethod?
  deliveryAddress     String?
  deliveryScheduledAt DateTime?
  deliveredAt         DateTime?

  // Cierre con saldo pendiente (excepción autorizada)
  closeExceptionReason String?
  closeExceptionBy     String?

  cancelReason  String?
  internalNotes String?
  isTestData    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderItem[]
  payments      Payment[]
  statusChanges OrderStatusChange[]
  incidents     OrderIncident[]
  cashMovements CashMovement[]

  @@index([status])
  @@index([customerId])
}

enum InspectionResult {
  PENDING
  APPROVED
  REJECTED
}

// Copia de los datos acordados: una actualización del catálogo no la modifica.
model OrderItem {
  id                String           @id @default(cuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  brand             String
  model             String
  internalSku       String?
  size              String?
  color             String?
  quantity          Int              @default(1)
  agreedPrice       Int // precio unitario acordado con el cliente (centavos)
  costSnapshot      Int? // costo del proveedor vigente al cotizar
  costHistoryId     String?
  costConsultedAt   DateTime?
  actualCost        Int? // costo realmente pagado al proveedor
  inspection        InspectionResult @default(PENDING)
  inspectionNotes   String?
  inspectedAt       DateTime?
  inspectedBy       String?
  createdAt         DateTime         @default(now())
  supplierMessage   SupplierMessage? @relation(fields: [supplierMessageId], references: [id])
  supplierMessageId String?
}

model OrderStatusChange {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  note      String?
  userEmail String?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

enum PaymentMethod {
  CASH
  TRANSFER
  MERCADO_PAGO
  CARD
  OTHER
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  amount         Int
  method         PaymentMethod
  paidAt         DateTime
  reference      String? // n° de operación
  idempotencyKey String        @unique // impide registrar dos veces el mismo pago
  createdBy      String?
  createdAt      DateTime      @default(now())
  cashMovement   CashMovement?

  @@unique([method, reference])
}

enum IncidentType {
  DELAY
  MISSING
  WRONG_ITEM
  DAMAGED
  CUSTOMER
  OTHER
}

model OrderIncident {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        IncidentType
  description String
  resolvedAt  DateTime?
  resolution  String?
  createdBy   String?
  createdAt   DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Caja
// ---------------------------------------------------------------------------

enum CashMovementType {
  CUSTOMER_PAYMENT // ingreso: cobro a cliente
  OTHER_INCOME
  SUPPLIER_PAYMENT // egreso: compra al proveedor
  REFUND // egreso: devolución a cliente
  ORDER_EXPENSE // egreso: envío, embalaje, comisión de un pedido
  OPERATING_EXPENSE // egreso: gasto operativo general
}

model CashMovement {
  id          String           @id @default(cuid())
  type        CashMovementType
  amount      Int // siempre positivo; el tipo indica si entra o sale
  occurredAt  DateTime
  description String
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id])
  paymentId   String?          @unique
  payment     Payment?         @relation(fields: [paymentId], references: [id])
  method      PaymentMethod?
  createdBy   String?
  isTestData  Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([occurredAt])
  @@index([orderId])
}
