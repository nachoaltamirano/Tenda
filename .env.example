# Base de datos principal (en producción: cadena de Supabase/Neon con sslmode=require)
DATABASE_URL="postgresql://lobby:lobby_dev@localhost:5432/lobby_dev"
# Conexión directa para migraciones. Local: igual a DATABASE_URL. Supabase: la "Direct connection" (puerto 5432).
DIRECT_URL="postgresql://lobby:lobby_dev@localhost:5432/lobby_dev"
# Base exclusiva para pruebas automatizadas. NUNCA apuntar a la base real.
TEST_DATABASE_URL="postgresql://lobby:lobby_dev@localhost:5432/lobby_test"

# Secreto para firmar la cookie de sesión del panel (mínimo 32 caracteres aleatorios).
# Generar con: openssl rand -base64 48
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-48-bytes"

# Almacenamiento de imágenes: "local" (carpeta ./storage) o "s3" (Supabase Storage u otro S3-compatible; obligatorio en Vercel).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Primer administrador: si no existe ninguno, se crea al desplegar (prisma/seed.ts). Cambiar la contraseña después.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_INITIAL_PASSWORD=""

# URL pública de la tienda (para enlaces de WhatsApp y SEO)
PUBLIC_SITE_URL="http://localhost:3000"
# Número de WhatsApp Business de LOBBY en formato internacional sin "+" (ej: 5493410000000). Pendiente.
PUBLIC_WHATSAPP_NUMBER=""
