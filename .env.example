# Base de datos principal (en producción: cadena de Supabase/Neon con sslmode=require)
DATABASE_URL="postgresql://lobby:lobby_dev@localhost:5432/lobby_dev"
# Base exclusiva para pruebas automatizadas. NUNCA apuntar a la base real.
TEST_DATABASE_URL="postgresql://lobby:lobby_dev@localhost:5432/lobby_test"

# Secreto para firmar la cookie de sesión del panel (mínimo 32 caracteres aleatorios).
# Generar con: openssl rand -base64 48
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-48-bytes"

# Almacenamiento de imágenes: "local" (carpeta ./storage) o "s3" (Supabase Storage / Cloudflare R2), etapa 6.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# URL pública de la tienda (para enlaces de WhatsApp y SEO)
PUBLIC_SITE_URL="http://localhost:3000"
# Número de WhatsApp Business de LOBBY en formato internacional sin "+" (ej: 5493410000000). Pendiente.
PUBLIC_WHATSAPP_NUMBER=""
